# Required. Subscription billing, not API credits.
#   npx @anthropic-ai/claude-code setup-token
# Requires a Pro / Max / Team / Enterprise plan. The token lasts a year.
CLAUDE_CODE_OAUTH_TOKEN=

# Do NOT set ANTHROPIC_API_KEY here. The agent refuses to boot if it is set,
# because usage would silently bill to API credits instead of the subscription.

# The agent computes "오늘" for the model. UTC is a day off for anyone east of
# Greenwich once it passes local midnight.
TZ=Asia/Seoul

# Optional. Empty means the CLI's default.
JARVIS_MODEL=

# Tools that run without an approval card. Keep this list read-only.
JARVIS_ALLOWED_TOOLS=Read,Glob,Grep,TodoWrite,mcp__calendar__list_events,mcp__assets__get_portfolio,mcp__assets__get_allocation,mcp__assets__get_history,mcp__spending__get_spending

# Host directory the agent may read and act on.
JARVIS_WORKSPACE_HOST=./workspace

# How long a card waits before it expires as a rejection.
JARVIS_APPROVAL_TIMEOUT=30m

# Logs every permission payload verbatim. Useful on first run.
JARVIS_DEBUG=false

JARVIS_WEB_PORT=3000

# ── Postgres + pgvector ───────────────────────────────────────────────────
# 이벤트 로그, 파생 테이블, 회수용 벡터가 모두 한 데이터베이스에 있습니다.
# 비밀번호는 기본값이 없습니다 - 없으면 compose 가 그 자리에서 멈춥니다.
#   openssl rand -hex 24
JARVIS_POSTGRES_PASSWORD=
JARVIS_POSTGRES_USER=jarvis
JARVIS_POSTGRES_DB=jarvis
# 호스트에 이미 postgres 가 돌고 있으면 여기를 5433 같은 값으로 옮기세요.
# 컨테이너 사이의 연결은 이 값과 무관합니다(항상 postgres:5432).
JARVIS_POSTGRES_PORT=5432

# ── 기능 서비스 ───────────────────────────────────────────────────────────
# 전부 루프백에만 열립니다. 웹이 서버측에서 프록시하므로 브라우저는 이 포트를
# 알 필요가 없고, curl 로 직접 두드려 보기 위한 것입니다.
JARVIS_WORKOUT_PORT=8091
JARVIS_ASSETS_PORT=8092
JARVIS_CALENDAR_PORT=8093
JARVIS_CHAT_PORT=8094

# ── KakaoTalk collector (kakaotalk-client) ────────────────────────────────
# Polls the local KakaoTalk database and serves collected messages.
# Poll interval. 1s is the sweet spot; 250ms is the floor, below that is waste.
KAKAO_POLL_INTERVAL=1s
# Loopback host port for the collector's API.
KAKAO_PORT=8090
# Identity used to derive the SQLCipher key. A Linux container cannot read the
# Mac's UUID, so set these when running under Docker. Get the UUID with:
#   ioreg -rd1 -c IOPlatformExpertDevice | awk -F'"' '/IOPlatformUUID/{print $4}'
# Leave KAKAO_USER_ID empty to auto-recover it from the KakaoTalk plist (a
# one-time scan). KAKAO_SQLCIPHER_KEY overrides both when provided.
KAKAO_UUID=
KAKAO_USER_ID=
KAKAO_SQLCIPHER_KEY=
# Override only if KakaoTalk stores its data somewhere non-standard.
# KAKAO_CONTAINER_HOST=
# KAKAO_PLIST_HOST=

# 한국투자증권 금현물 계좌 (선택). 주식 계좌와 별도로 발급한 앱키.
KIS_GOLD_APP_KEY=
KIS_GOLD_APP_SECRET=
KIS_GOLD_ACCOUNT_NO=
KIS_GOLD_ACCOUNT_PRODUCT=01

# uniple(커플 앱) 공유 캘린더. calendar-svc 의 일정 저장소.
CALENDAR_BACKEND=uniple
UNIPLE_ANON_KEY=
UNIPLE_REFRESH_TOKEN=

# 콘솔 로그인. 기본값이 없다 - 비어 있으면 아무도 로그인할 수 없다.
JARVIS_AUTH_ID=
JARVIS_AUTH_PASSWORD=
# 세션 쿠키 서명 키. 비우면 비밀번호에서 만든다. openssl rand -hex 32
JARVIS_AUTH_SECRET=

# 조회할 곳이 없는 고정 자산. 예: [{"id":"housing-subscription","label":"주택청약","valueKrw":1000000}]
FIXED_ASSETS=
