# Required. Subscription billing, not API credits.
#   npx @anthropic-ai/claude-code setup-token
# Requires a Pro / Max / Team / Enterprise plan. The token lasts a year.
CLAUDE_CODE_OAUTH_TOKEN=

# Do NOT set ANTHROPIC_API_KEY here. The agent refuses to boot if it is set,
# because usage would silently bill to API credits instead of the subscription.

# The agent computes "오늘" for the model. UTC is a day off for anyone east of
# Greenwich once it passes local midnight.
TZ=Asia/Seoul

# Optional. Empty means the CLI's default.
JARVIS_MODEL=

# Tools that run without an approval card. Keep this list read-only.
JARVIS_ALLOWED_TOOLS=Read,Glob,Grep,TodoWrite,mcp__calendar__list_events

# Host directory the agent may read and act on.
JARVIS_WORKSPACE_HOST=./workspace

# How long a card waits before it expires as a rejection.
JARVIS_APPROVAL_TIMEOUT=30m

# Logs every permission payload verbatim. Useful on first run.
JARVIS_DEBUG=false

JARVIS_WEB_PORT=3000
