#!/usr/bin/env bash
# 맥북에서 고치고, 맥미니에서 돌린다.
#
#   scripts/mini up [서비스...]     코드를 맥미니로 보내고 docker compose up -d --build
#   scripts/mini sync               보내기만
#   scripts/mini ps                 컨테이너 상태
#   scripts/mini logs [-f] 서비스   로그
#   scripts/mini restart 서비스     재시작 (빌드 없이)
#   scripts/mini down               전부 내림
#   scripts/mini exec 서비스 명령…   컨테이너 안에서 실행
#   scripts/mini psql [SQL]         맥미니 Postgres 에 붙음
#   scripts/mini compose …          그 밖의 docker compose 명령 그대로
#   scripts/mini env-push           이 맥북의 .env 를 맥미니로 (덮어쓰기 전에 묻는다)
#   scripts/mini check              접속·도커·.env 가 준비됐는지
#   scripts/mini volumes-push 볼륨…  맥북의 도커 볼륨을 맥미니로 (양쪽 스택이 내려가 있을 때)
#
# 왜 docker context(ssh://) 가 아니라 rsync + ssh 인가: compose 의 바인드 마운트
# (./workspace, 카카오톡 앱 데이터 경로)는 compose 를 실행한 쪽의 경로로 풀린다.
# 맥북에서 원격 데몬에 compose 를 걸면 맥북 경로가 맥미니에 넘어가 엉뚱한 곳을
# 가리킨다. 코드를 맥미니에 두고 거기서 실행하면 그 문제가 없다.
#
# 접속 대상은 ~/.ssh/config 의 Host 별칭이다(기본 macmini). 다른 이름이면
# MINI_HOST=..., 맥미니 쪽 디렉터리는 MINI_DIR=... (기본 ~/jarvis).
set -euo pipefail

HOST="${MINI_HOST:-macmini}"
DIR="${MINI_DIR:-jarvis}"   # 맥미니 홈 기준 상대 경로
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# 비대화형 ssh 셸에는 Homebrew·Docker Desktop·OrbStack 경로가 PATH 에 없다.
REMOTE_PATH='export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.orbstack/bin:/Applications/Docker.app/Contents/Resources/bin:$PATH"'

remote() {
  # 인자는 원격 셸에서 다시 해석되므로 하나씩 따옴표로 감싼다.
  local cmd="" a
  for a in "$@"; do cmd+=" $(printf '%q' "$a")"; done
  ssh -t -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; cd ~/$DIR && $cmd"
}

compose() { remote docker compose "$@"; }

sync() {
  echo "→ $HOST:~/$DIR 로 코드를 보냅니다"
  ssh -o LogLevel=ERROR "$HOST" "mkdir -p ~/$DIR"
  # --delete: 맥북에서 지운 파일은 맥미니에서도 지운다.
  # 제외 목록은 맥미니에서 따로 사는 것들이라 --delete 로도 지워지지 않는다:
  #   .env       비밀 - env-push 로만, 묻고 나서 옮긴다
  #   workspace  에이전트가 일하는 디렉터리 - 맥미니의 것이 진짜다
  #   빌드 산출물·의존성  이미지 안에서 다시 만든다
  rsync -az --delete \
    --exclude '.git/' \
    --exclude '.env' --exclude '.env.local' \
    --exclude '/workspace/' \
    --exclude 'node_modules/' --exclude '.next/' --exclude '.open-next/' --exclude '.wrangler/' \
    --exclude 'dist/' --exclude 'agent/data/' --exclude 'kakaotalk-client/data/' \
    --exclude '.DS_Store' --exclude '*.pprof' \
    "$ROOT/" "$HOST:$DIR/"
}

check() {
  echo "접속: $HOST"
  ssh -o ConnectTimeout=5 -o LogLevel=ERROR "$HOST" true \
    || { echo "  ✗ ssh $HOST 가 안 됩니다. ~/.ssh/config 와 맥미니의 '원격 로그인'을 확인하세요."; exit 1; }
  echo "  ✓ ssh"
  ssh -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; docker version --format '  ✓ docker {{.Server.Version}}' 2>/dev/null" \
    || echo "  ✗ docker 데몬에 붙지 못했습니다. 맥미니에서 Docker Desktop(또는 OrbStack)이 켜져 있는지 확인하세요."
  ssh -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; docker compose version --short >/dev/null 2>&1 && echo '  ✓ docker compose'" \
    || echo "  ✗ docker compose 가 없습니다."
  if ssh -o LogLevel=ERROR "$HOST" "test -f ~/$DIR/.env"; then
    echo "  ✓ ~/$DIR/.env"
  else
    echo "  ✗ ~/$DIR/.env 가 없습니다. scripts/mini env-push 로 옮기세요."
  fi
}

env_push() {
  if ssh -o LogLevel=ERROR "$HOST" "test -f ~/$DIR/.env"; then
    echo "맥미니에 이미 .env 가 있습니다. 차이:"
    diff <(ssh -o LogLevel=ERROR "$HOST" "cat ~/$DIR/.env" | sed -E 's/=.*/=…/') <(sed -E 's/=.*/=…/' "$ROOT/.env") \
      && echo "  (키 목록은 같습니다)"
    read -r -p "맥북의 .env 로 덮어쓸까요? [y/N] " yes
    [[ "$yes" == "y" || "$yes" == "Y" ]] || { echo "그만둡니다."; exit 0; }
  fi
  ssh -o LogLevel=ERROR "$HOST" "mkdir -p ~/$DIR"
  scp -q "$ROOT/.env" "$HOST:$DIR/.env"
  ssh -o LogLevel=ERROR "$HOST" "chmod 600 ~/$DIR/.env"
  echo "✓ .env 를 옮겼습니다. 카카오톡 식별값(KAKAO_UUID 등)은 기계마다 다르니 맥미니 값으로 고치세요."
}

# 볼륨을 통째로 옮긴다. Postgres 도 파일째 옮기므로 양쪽 스택이 모두 내려가
# 있어야 한다 - 돌고 있는 데이터베이스의 파일을 복사하면 깨진 사본이 된다.
# 맥미니 쪽 볼륨에 이미 무언가 있으면 멈춘다. 그쪽이 진짜일 수 있다.
volumes_push() {
  [[ $# -gt 0 ]] || { echo "옮길 볼륨 이름을 주세요 (예: jarvis-postgres)"; exit 1; }
  local project="${MINI_PROJECT:-jarvis}" v name used
  if docker compose -f "$ROOT/docker-compose.yml" ps -q 2>/dev/null | grep -q .; then
    echo "맥북의 스택이 돌고 있습니다. 먼저 docker compose down 하세요."; exit 1
  fi
  if ssh -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; cd ~/$DIR 2>/dev/null && docker compose ps -q" | grep -q .; then
    echo "맥미니의 스택이 돌고 있습니다. 먼저 scripts/mini down 하세요."; exit 1
  fi
  for v in "$@"; do
    name="${project}_${v}"
    docker volume inspect "$name" >/dev/null 2>&1 || { echo "✗ 맥북에 $name 볼륨이 없습니다"; exit 1; }
    used=$(ssh -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; docker volume inspect $name >/dev/null 2>&1 && docker run --rm -v $name:/v alpine sh -c 'ls -A /v | head -1'" || true)
    if [[ -n "$used" && "${FORCE:-}" != "1" ]]; then
      echo "✗ 맥미니의 $name 에 이미 데이터가 있습니다. 덮어쓰려면 FORCE=1"; exit 1
    fi
    echo "→ $name"
    # compose 가 자기 볼륨으로 알아보도록 같은 라벨을 붙여 만든다.
    ssh -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; docker volume inspect $name >/dev/null 2>&1 || docker volume create \
      --label com.docker.compose.project=$project --label com.docker.compose.volume=$v $name >/dev/null"
    docker run --rm -v "$name":/v alpine tar -C /v -czf - . \
      | ssh -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; docker run --rm -i -v $name:/v alpine sh -c 'rm -rf /v/..?* /v/.[!.]* /v/* 2>/dev/null; tar -C /v -xzpf -'"
    echo "  ✓ $(ssh -o LogLevel=ERROR "$HOST" "$REMOTE_PATH; docker run --rm -v $name:/v alpine du -sh /v" | cut -f1)"
  done
}

cmd="${1:-}"
shift || true
case "$cmd" in
  up)       sync && compose up -d --build "$@" ;;
  sync)     sync ;;
  ps)       compose ps "$@" ;;
  logs)     compose logs --tail=200 "$@" ;;
  restart)  compose restart "$@" ;;
  down)     compose down "$@" ;;
  exec)     compose exec "$@" ;;
  psql)
    if [[ $# -gt 0 ]]; then compose exec -T postgres psql -U jarvis -d jarvis -c "$*"
    else compose exec postgres psql -U jarvis -d jarvis; fi ;;
  compose)  compose "$@" ;;
  env-push) env_push ;;
  check)    check ;;
  volumes-push) volumes_push "$@" ;;
  *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
