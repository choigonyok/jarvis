#!/usr/bin/env bash
# 그림 속 글자 읽기(OCR, ocr/main.swift)를 맥미니에 설치하거나 돌본다. 맥북에서 실행한다.
#
#   scripts/ocr install     ocr/main.swift 만 보내고, 맥미니에서 swiftc 로 빌드해 ~/.jarvis-ocr/jarvis-ocr 에 두고
#                           LaunchAgent com.jarvis.ocr 로 띄운다. 다시 실행하면 다시 빌드하고 재시작한다.
#   scripts/ocr status      돌고 있는지, /health, 마지막 로그
#   scripts/ocr logs [-f]   로그
#   scripts/ocr restart     재시작 (.env 의 토큰을 바꿨을 때)
#   scripts/ocr uninstall   멈추고 LaunchAgent·바이너리를 지운다
#
# 왜 compose 가 아니라 호스트인가: 애플 Vision 은 macOS 의 것이고 컨테이너(리눅스)에는 없다.
# search-svc 는 host.docker.internal:8107 로 닿는다(루프백에만 묶여 같은 와이파이에서는 안 보인다).
# 토큰은 맥미니 ~/jarvis/.env 의 JARVIS_SEARCH_TOKEN - search-svc 와 같은 값이다.
#
# 코드는 이 파일 하나만 scp 로 보낸다: scripts/mini sync 는 rsync --delete 라 worktree 에서
# 돌리면 깃에 없는 맥미니의 파일을 지운다.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${MINI_HOST:-macmini}"
DIR="${MINI_DIR:-jarvis}"
LABEL=com.jarvis.ocr
PORT="${OCR_PORT:-8107}"

remote() { ssh -o LogLevel=ERROR "$HOST" "$@"; }

case "${1:-}" in
  install)
    remote "mkdir -p ~/$DIR/ocr"
    scp -q -o LogLevel=ERROR "$ROOT/ocr/main.swift" "$HOST:$DIR/ocr/main.swift"
    remote "bash -s" <<SH
set -euo pipefail
STATE=\$HOME/.jarvis-ocr
LOG=\$HOME/Library/Logs/jarvis-ocr.log
P=\$HOME/Library/LaunchAgents/$LABEL.plist
mkdir -p "\$STATE" "\$HOME/Library/Logs" "\$HOME/Library/LaunchAgents"
if ! grep -q '^JARVIS_SEARCH_TOKEN=.' "\$HOME/$DIR/.env"; then
  echo "맥미니 ~/$DIR/.env 에 JARVIS_SEARCH_TOKEN 이 없습니다(openssl rand -hex 24 로 만들어 넣으세요)."
  exit 1
fi
echo "→ 빌드 (swiftc)"
swiftc -O -swift-version 5 "\$HOME/$DIR/ocr/main.swift" -o "\$STATE/jarvis-ocr.new"
mv "\$STATE/jarvis-ocr.new" "\$STATE/jarvis-ocr"

cat > "\$P" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array>
    <string>\$STATE/jarvis-ocr</string>
    <string>--port</string><string>$PORT</string>
    <string>--env-file</string><string>\$HOME/$DIR/.env</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>\$LOG</string>
  <key>StandardErrorPath</key><string>\$LOG</string>
</dict></plist>
PL
launchctl bootout "gui/\$(id -u)/$LABEL" 2>/dev/null || true
launchctl bootstrap "gui/\$(id -u)" "\$P"
for i in \$(seq 1 20); do
  if curl -fs "http://127.0.0.1:$PORT/health" >/dev/null; then echo "→ 띄웠습니다: \$(curl -s http://127.0.0.1:$PORT/health)"; exit 0; fi
  sleep 1
done
echo "아직 답이 없습니다. scripts/ocr logs 로 보세요."; tail -20 "\$LOG"; exit 1
SH
    ;;
  status)
    remote "launchctl print gui/\$(id -u)/$LABEL 2>/dev/null | grep -E 'state|pid' | head -2 || echo '돌고 있지 않습니다'; curl -s http://127.0.0.1:$PORT/health; echo; tail -5 ~/Library/Logs/jarvis-ocr.log 2>/dev/null"
    ;;
  logs)
    shift || true
    remote "tail ${1:--n 50} ~/Library/Logs/jarvis-ocr.log"
    ;;
  restart)
    remote "launchctl kickstart -k gui/\$(id -u)/$LABEL && echo 재시작했습니다"
    ;;
  uninstall)
    remote "launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true; rm -rf ~/Library/LaunchAgents/$LABEL.plist ~/.jarvis-ocr; echo 지웠습니다"
    ;;
  *) sed -n '2,17p' "$0"; exit 1 ;;
esac
