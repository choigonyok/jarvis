#!/usr/bin/env bash
# 맥 상주 수집기(context-svc/cmd/mac-collector)를 이 맥에 설치하거나 지운다.
#
#   scripts/mac-collector install   빌드 → ~/.local/bin, 신호 토큰 → ~/.config/jarvis/signal-token(0600),
#                                   LaunchAgent com.jarvis.mac-collector 로 로그인할 때마다 뜬다
#   scripts/mac-collector uninstall 멈추고 지운다(토큰 파일도)
#   scripts/mac-collector status    돌고 있는지, 마지막 로그
#
# 보내는 것은 상태의 종류뿐이다: 앞에 있는 앱의 종류(meeting/code/chat/browser/other), 방금 복사한
# 것의 종류(tracking/address/date). 앱 이름·창 제목·복사한 내용은 맥을 떠나지 않고, 비밀번호 관리자가
# 앞에 있을 때 복사한 것은 보지도 않는다. 다운로드·스크린샷 감시(-files)는 macOS 가 폴더 접근을
# 묻기 때문에 기본으로 끈다.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${MINI_HOST:-macmini}"
LABEL=com.jarvis.mac-collector
BIN="$HOME/.local/bin/jarvis-mac-collector"
TOKEN="$HOME/.config/jarvis/signal-token"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
URL="${CONTEXT_SIGNALS_URL:-https://jarvis-be.choigonyok.com/context/signals}"
LOG="$HOME/Library/Logs/jarvis-mac-collector.log"

case "${1:-}" in
  install)
    mkdir -p "$(dirname "$BIN")" "$(dirname "$TOKEN")" "$(dirname "$PLIST")" "$(dirname "$LOG")"
    (cd "$ROOT/context-svc" && go build -trimpath -o "$BIN" ./cmd/mac-collector)
    if [[ ! -s "$TOKEN" ]]; then
      umask 077
      ssh -o LogLevel=ERROR "$HOST" "grep -E '^CONTEXT_SIGNAL_TOKEN=' ~/jarvis/.env | cut -d= -f2-" > "$TOKEN"
      [[ -s "$TOKEN" ]] || { echo "맥미니 .env 에서 CONTEXT_SIGNAL_TOKEN 을 읽지 못했습니다" >&2; rm -f "$TOKEN"; exit 1; }
    fi
    chmod 600 "$TOKEN"
    cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$BIN</string><string>-url</string><string>$URL</string><string>-token-file</string><string>$TOKEN</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PL
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "설치했습니다: $LABEL → $URL"
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST" "$BIN" "$TOKEN"
    echo "지웠습니다"
    ;;
  status)
    launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | grep -E "state|pid" | head -3 || echo "돌고 있지 않습니다"
    tail -5 "$LOG" 2>/dev/null || true
    ;;
  *) sed -n '2,14p' "$0"; exit 1 ;;
esac
