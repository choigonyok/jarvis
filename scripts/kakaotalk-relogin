#!/usr/bin/env bash
# 맥미니 카톡이 로그아웃되면 다시 로그인한다(kakaotalk-client/cmd/relogin). 맥북에서 실행한다.
#
#   scripts/kakaotalk-relogin install   빌드해 앱(JarvisKakaoRelogin.app, "Jarvis 카톡 자동 로그인")으로 묶고
#                                       서명해 맥미니 /Applications 에 두고, LaunchAgent com.jarvis.kakaotalk-relogin 으로 띄운다
#   scripts/kakaotalk-relogin password  카카오 계정·비밀번호를 받아 맥미니 키체인에 넣는다
#                                       (이 터미널에서 직접 입력 - 화면에 보이지 않고, 기록에도 남지 않는다)
#   scripts/kakaotalk-relogin status    돌고 있는지, 지금 상태, 마지막 로그
#   scripts/kakaotalk-relogin inspect   카톡 창의 구조(역할·버튼 이름)를 받아 본다 - 로그인 창이 바뀌었을 때
#   scripts/kakaotalk-relogin uninstall 멈추고 지운다(키체인의 비밀번호는 남는다)
#
# 사람이 할 일(맥미니 앞에서, 한 번): 처음 뜨면 macOS 가 "손쉬운 사용"을 허락할지 묻는다 → 시스템 설정 →
# 개인정보 보호 및 보안 → 손쉬운 사용에서 "Jarvis 카톡 자동 로그인"을 켠다(목록에 없으면 + → 응용 프로그램 →
# JarvisKakaoRelogin). 앱은 이 맥의 Apple Development 인증서로 서명해서(JARVIS_CODESIGN_IDENTITY 로 바꿀 수
# 있다) 다시 빌드해도 macOS 가 같은 프로그램으로 본다 - 허락과 키체인 항목이 그대로 남는다. 인증서가 없으면
# 임시 서명으로 하고, 그때는 설치할 때마다 둘 다 다시 해야 한다.
#
# 하는 일: 5초마다 카톡 창을 보고, 로그아웃 안내의 '확인'을 누르고, 로그인 창이면 인터넷이 돌아오는 대로
# 키체인의 비밀번호로 로그인한다. 실패하면 10초 뒤, 조금씩 늘려 최대 5분 간격으로 계속 다시 해 보고,
# 비밀번호가 맞지 않다는 안내나 휴대폰 확인 화면이 뜨면 바로 멈춘다(틀린 비밀번호를 계속 넣으면 계정이
# 잠긴다). 상태는 ~/.jarvis-host/kakaotalk-login.json 에 적고, 상태 탭의 '카톡 로그인' 줄이 보여 준다.
#
# 맥미니 화면이 잠겨 있으면 macOS 가 모든 앱의 창을 감춰서 아무것도 하지 못한다(메뉴만 읽혀 로그아웃됐는지만 안다).
# 디스플레이가 꺼지기만 해도 잠김으로 친다. 그래서 맥미니는 잠금에 비밀번호를 걸지 않는다: 시스템 설정 → 잠금 화면 →
# 화면 보호기가 시작되거나 디스플레이가 꺼진 후 암호 요구 → 안 함. 그러면 로그아웃이 보일 때 꺼진 화면을 깨워(waking)
# 잠금이 저절로 풀리고 로그인한다. 비밀번호 잠금이면 상태 탭에 locked(로그아웃, 이상) / locked-in(로그인, 주의)으로 보인다.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${MINI_HOST:-macmini}"
LABEL=com.jarvis.kakaotalk-relogin
APP=JarvisKakaoRelogin.app
EXE=/Applications/$APP/Contents/MacOS/jarvis-kakaotalk-relogin
OLD_BIN=.local/bin/jarvis-kakaotalk-relogin # the first build, a bare binary
LOG='$HOME/Library/Logs/jarvis-kakaotalk-relogin.log'
STATUS='$HOME/.jarvis-host/kakaotalk-login.json'

remote() { ssh -o LogLevel=ERROR "$HOST" "$@"; }

case "${1:-}" in
  install)
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    mkdir -p "$tmp/$APP/Contents/MacOS"
    (cd "$ROOT/kakaotalk-client" && CGO_ENABLED=1 GOOS=darwin GOARCH=arm64 go build -trimpath -o "$tmp/$APP/Contents/MacOS/jarvis-kakaotalk-relogin" ./cmd/relogin)
    # An app, not a bare binary: the 손쉬운 사용 list names it, its + finds it in
    # Applications, and macOS keeps its grant by bundle id.
    cat > "$tmp/$APP/Contents/Info.plist" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>$LABEL</string>
  <key>CFBundleName</key><string>Jarvis 카톡 자동 로그인</string>
  <key>CFBundleDisplayName</key><string>Jarvis 카톡 자동 로그인</string>
  <key>CFBundleExecutable</key><string>jarvis-kakaotalk-relogin</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>$(date +%Y%m%d%H%M)</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PL
    # A lasting identity, so a rebuild is the same program to macOS: its
    # Accessibility grant and its keychain item stay. Ad-hoc only without one.
    identity="${JARVIS_CODESIGN_IDENTITY:-$(security find-identity -v -p codesigning 2>/dev/null | sed -n 's/.*"\(Apple Development: [^"]*\)".*/\1/p' | head -1)}"
    if [[ -n "$identity" ]]; then
      codesign --force --timestamp=none --sign "$identity" "$tmp/$APP"
      echo "서명: $identity"
    else
      codesign --force --sign - --identifier "$LABEL" "$tmp/$APP"
      echo "서명할 인증서가 없어 임시 서명했어요 - 설치할 때마다 손쉬운 사용 허락과 비밀번호를 다시 해야 해요." >&2
    fi
    COPYFILE_DISABLE=1 tar -C "$tmp" -cf - "$APP" | remote "rm -rf /Applications/$APP.new && mkdir /Applications/$APP.new && tar -C /Applications/$APP.new -xf - && rm -rf /Applications/$APP && mv /Applications/$APP.new/$APP /Applications/$APP && rmdir /Applications/$APP.new"
    remote "bash -s" <<SH
set -e
mkdir -p ~/.jarvis-host ~/.config/jarvis ~/Library/LaunchAgents ~/Library/Logs
P=\$HOME/Library/LaunchAgents/$LABEL.plist
# The first build ran from ~/.local/bin and asked for access once: the app asks anew.
if [ -e \$HOME/$OLD_BIN ]; then rm -f \$HOME/$OLD_BIN ~/.config/jarvis/kakaotalk-relogin.prompted; fi
cat > "\$P" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$EXE</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PL
launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true
launchctl bootstrap gui/\$(id -u) "\$P"
sleep 3
echo "설치했습니다: $LABEL (/Applications/$APP)"
cat $STATUS 2>/dev/null || true
SH
    echo "처음 설치(또는 임시 서명)라면 맥미니에서 손쉬운 사용에 'Jarvis 카톡 자동 로그인'을 켜 주세요."
    echo "비밀번호가 아직 없으면: scripts/kakaotalk-relogin password"
    ;;
  password)
    printf '카카오 계정 (로그인 창에 이미 적혀 있으면 그냥 Enter): '
    IFS= read -r account
    printf '카카오 비밀번호 (화면에 보이지 않아요): '
    IFS= read -rs pw
    echo
    if [[ -z "$pw" ]]; then echo "비밀번호가 비었습니다" >&2; exit 1; fi
    # 맥미니에 0600 파일로 넘기면 자동 로그인 프로그램이 키체인으로 옮기고 지운다 - 키체인은 그 사람의
    # 세션에서만 열려 있어서 SSH 로는 바로 넣을 수 없다.
    printf '%s\n%s\n' "$account" "$pw" | remote 'umask 077; cat > ~/.config/jarvis/kakaotalk-login.new.tmp && mv ~/.config/jarvis/kakaotalk-login.new.tmp ~/.config/jarvis/kakaotalk-login.new'
    unset pw
    echo "맥미니로 보냈습니다. 키체인에 옮겨지기를 기다립니다…"
    for _ in $(seq 1 20); do
      sleep 3
      if remote 'test ! -e ~/.config/jarvis/kakaotalk-login.new'; then
        if remote "grep -q '\"password\":\"stored\"' $STATUS"; then
          echo "키체인에 저장했습니다."
          exit 0
        fi
        echo "옮기지 못했습니다 - scripts/kakaotalk-relogin status 의 로그를 보세요." >&2
        exit 1
      fi
    done
    echo "아직 옮겨지지 않았어요. 프로그램이 돌고 있는지(scripts/kakaotalk-relogin status), 손쉬운 사용을 허락했는지 보세요." >&2
    echo "(비밀번호는 맥미니 ~/.config/jarvis/kakaotalk-login.new 에 0600 으로 기다리고 있어요.)" >&2
    exit 1
    ;;
  status)
    remote "launchctl print gui/\$(id -u)/$LABEL 2>/dev/null | grep -E 'state|pid' | head -2 || echo '돌고 있지 않습니다'; ioreg -n Root -d1 -a 2>/dev/null | grep -A1 CGSSessionScreenIsLocked | grep -q true && echo '화면: 잠김 - 이대로면 다시 로그인하지 못해요' || echo '화면: 잠기지 않음'; echo; cat $STATUS 2>/dev/null; echo; tail -8 $LOG 2>/dev/null"
    ;;
  inspect)
    # 프로그램이 다음 차례에 카톡 창 구조를 적는다(SSH 로는 손쉬운 사용 권한이 따라오지 않아서 파일로 부탁한다).
    remote 'touch ~/.jarvis-host/kakaotalk-inspect'
    for _ in $(seq 1 25); do
      sleep 2
      if remote 'test ! -e ~/.jarvis-host/kakaotalk-inspect'; then
        sleep 1
        remote 'cat ~/.config/jarvis/kakaotalk-ax.txt'
        exit 0
      fi
    done
    echo "프로그램이 응답하지 않았어요 - status 를 보세요." >&2
    exit 1
    ;;
  uninstall)
    remote "launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true; rm -rf ~/Library/LaunchAgents/$LABEL.plist /Applications/$APP ~/$OLD_BIN; echo 지웠습니다"
    ;;
  *) sed -n '2,21p' "$0"; exit 1 ;;
esac
