#!/usr/bin/env bash
# 맥미니 카톡이 로그아웃되면 다시 로그인한다(kakaotalk-client/cmd/relogin). 맥북에서 실행한다.
#
#   scripts/kakaotalk-relogin install   빌드해 맥미니 ~/.local/bin/jarvis-kakaotalk-relogin 으로 보내고
#                                       LaunchAgent com.jarvis.kakaotalk-relogin 으로 띄운다
#   scripts/kakaotalk-relogin password  카카오 계정·비밀번호를 받아 맥미니 키체인에 넣는다
#                                       (이 터미널에서 직접 입력 - 화면에 보이지 않고, 기록에도 남지 않는다)
#   scripts/kakaotalk-relogin status    돌고 있는지, 지금 상태, 마지막 로그
#   scripts/kakaotalk-relogin inspect   카톡 창의 구조(역할·버튼 이름)를 받아 본다 - 로그인 창이 바뀌었을 때
#   scripts/kakaotalk-relogin uninstall 멈추고 지운다(키체인의 비밀번호는 남는다)
#
# 사람이 할 일(맥미니 앞에서, 한 번): 처음 뜨면 macOS 가 "손쉬운 사용"을 허락할지 묻는다 → 시스템 설정 →
# 개인정보 보호 및 보안 → 손쉬운 사용에서 jarvis-kakaotalk-relogin 을 켠다. 다시 설치해 바이너리가 바뀌면
# 그 허락과 키체인 항목을 다시 해야 할 수 있다(임시 서명이라 macOS 가 새 프로그램으로 본다).
#
# 하는 일: 30초마다 카톡 창을 보고, 로그아웃 안내의 '확인'을 누르고, 로그인 창이면 인터넷이 돌아온 뒤
# 키체인의 비밀번호로 로그인한다. 한 번에 한 번, 실패하면 2분·10분 뒤, 세 번 연속 실패하면 멈춘다
# (틀린 비밀번호를 계속 넣으면 계정이 잠긴다). 휴대폰 확인 화면도 멈춘다. 상태는
# ~/.jarvis-host/kakaotalk-login.json 에 적고, 상태 탭의 '카톡 로그인' 줄이 그것을 보여 준다.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${MINI_HOST:-macmini}"
LABEL=com.jarvis.kakaotalk-relogin
BIN=.local/bin/jarvis-kakaotalk-relogin
LOG='$HOME/Library/Logs/jarvis-kakaotalk-relogin.log'
STATUS='$HOME/.jarvis-host/kakaotalk-login.json'

remote() { ssh -o LogLevel=ERROR "$HOST" "$@"; }

case "${1:-}" in
  install)
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    (cd "$ROOT/kakaotalk-client" && CGO_ENABLED=1 GOOS=darwin GOARCH=arm64 go build -trimpath -o "$tmp/jarvis-kakaotalk-relogin" ./cmd/relogin)
    # 임시 서명에 이름을 붙인다: 손쉬운 사용 목록에서 알아볼 수 있게.
    codesign --force --sign - --identifier "$LABEL" "$tmp/jarvis-kakaotalk-relogin"
    remote 'mkdir -p ~/.local/bin ~/.jarvis-host ~/.config/jarvis ~/Library/LaunchAgents ~/Library/Logs'
    scp -q "$tmp/jarvis-kakaotalk-relogin" "$HOST:$BIN"
    remote "bash -s" <<SH
set -e
P=\$HOME/Library/LaunchAgents/$LABEL.plist
cat > "\$P" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>\$HOME/$BIN</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PL
launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true
launchctl bootstrap gui/\$(id -u) "\$P"
sleep 3
echo "설치했습니다: $LABEL"
cat $STATUS 2>/dev/null || true
SH
    echo "맥미니 화면에 손쉬운 사용 허락을 묻는 창이 떴을 거예요. 시스템 설정에서 jarvis-kakaotalk-relogin 을 켜 주세요."
    echo "비밀번호가 아직 없으면: scripts/kakaotalk-relogin password"
    ;;
  password)
    printf '카카오 계정 (로그인 창에 이미 적혀 있으면 그냥 Enter): '
    IFS= read -r account
    printf '카카오 비밀번호 (화면에 보이지 않아요): '
    IFS= read -rs pw
    echo
    if [[ -z "$pw" ]]; then echo "비밀번호가 비었습니다" >&2; exit 1; fi
    # 맥미니에 0600 파일로 넘기면 자동 로그인 프로그램이 키체인으로 옮기고 지운다 - 키체인은 그 사람의
    # 세션에서만 열려 있어서 SSH 로는 바로 넣을 수 없다.
    printf '%s\n%s\n' "$account" "$pw" | remote 'umask 077; cat > ~/.config/jarvis/kakaotalk-login.new.tmp && mv ~/.config/jarvis/kakaotalk-login.new.tmp ~/.config/jarvis/kakaotalk-login.new'
    unset pw
    echo "맥미니로 보냈습니다. 키체인에 옮겨지기를 기다립니다…"
    for _ in $(seq 1 20); do
      sleep 3
      if remote 'test ! -e ~/.config/jarvis/kakaotalk-login.new'; then
        if remote "grep -q '\"password\":\"stored\"' $STATUS"; then
          echo "키체인에 저장했습니다."
          exit 0
        fi
        echo "옮기지 못했습니다 - scripts/kakaotalk-relogin status 의 로그를 보세요." >&2
        exit 1
      fi
    done
    echo "아직 옮겨지지 않았어요. 프로그램이 돌고 있는지(scripts/kakaotalk-relogin status), 손쉬운 사용을 허락했는지 보세요." >&2
    echo "(비밀번호는 맥미니 ~/.config/jarvis/kakaotalk-login.new 에 0600 으로 기다리고 있어요.)" >&2
    exit 1
    ;;
  status)
    remote "launchctl print gui/\$(id -u)/$LABEL 2>/dev/null | grep -E 'state|pid' | head -2 || echo '돌고 있지 않습니다'; echo; cat $STATUS 2>/dev/null; echo; tail -8 $LOG 2>/dev/null"
    ;;
  inspect)
    # 프로그램이 다음 차례에 카톡 창 구조를 적는다(SSH 로는 손쉬운 사용 권한이 따라오지 않아서 파일로 부탁한다).
    remote 'touch ~/.jarvis-host/kakaotalk-inspect'
    for _ in $(seq 1 25); do
      sleep 2
      if remote 'test ! -e ~/.jarvis-host/kakaotalk-inspect'; then
        sleep 1
        remote 'cat ~/.config/jarvis/kakaotalk-ax.txt'
        exit 0
      fi
    done
    echo "프로그램이 응답하지 않았어요 - status 를 보세요." >&2
    exit 1
    ;;
  uninstall)
    remote "launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true; rm -f ~/Library/LaunchAgents/$LABEL.plist ~/$BIN; echo 지웠습니다"
    ;;
  *) sed -n '2,20p' "$0"; exit 1 ;;
esac
