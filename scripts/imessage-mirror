#!/usr/bin/env bash
# iMessage 미러를 전용 바이너리로 돌린다(imessage-client/cmd/mirror). 맥북에서 실행한다.
#
#   scripts/imessage-mirror install  빌드해 맥미니 ~/.local/bin/jarvis-imessage-mirror 로 보내고
#                                    LaunchAgent com.jarvis.imessage-mirror 를 그 바이너리로 바꾼다
#   scripts/imessage-mirror status   지금 방식(binary | ssh)과 마지막 로그
#
# 바이너리는 전체 디스크 접근 권한이 없으면 예전 SSH 방식(scripts/imessage-mirror.sh)을 대신
# 돌리고, 5분마다 새로 떠서 권한을 다시 확인한다. 권한이 생기면 그다음 시작부터 직접 복사한다 -
# 미러가 끊기는 때는 없다.
#
# 사람이 할 일(S-8): 맥미니의 시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근 권한 → + →
# ~/.local/bin/jarvis-imessage-mirror (Cmd+Shift+. 로 숨은 폴더를 보인다). 5분 안에 status 가
# binary 로 바뀐다(상태 탭에도 보인다). 그 뒤 같은 목록에서 sshd-keygen-wrapper(원격 로그인)의
# 권한을 끄고, authorized_keys 에서 jarvis-imessage-mirror 키 줄을 지운다.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${MINI_HOST:-macmini}"
LABEL=com.jarvis.imessage-mirror
LOG=/tmp/jarvis-imessage-mirror.log

remote() { ssh -o LogLevel=ERROR "$HOST" "$@"; }

case "${1:-}" in
  install|switch)
    tmp=$(mktemp -d)
    (cd "$ROOT/imessage-client" && GOOS=darwin GOARCH=arm64 go build -trimpath -o "$tmp/jarvis-imessage-mirror" ./cmd/mirror)
    remote 'mkdir -p ~/.local/bin'
    scp -q "$tmp/jarvis-imessage-mirror" "$HOST:.local/bin/jarvis-imessage-mirror"
    rm -rf "$tmp"
    remote "bash -s" <<SH
set -e
P=\$HOME/Library/LaunchAgents/$LABEL.plist
B=\$HOME/.local/bin/jarvis-imessage-mirror
K=\$HOME/.ssh/jarvis_mirror
# 예전 SSH 방식의 plist 는 기록으로 남겨 둔다.
if grep -q /usr/bin/ssh "\$P" 2>/dev/null; then cp "\$P" "\$P.ssh-backup"; fi
cat > "\$P" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>\$B</string><string>-ssh-key</string><string>\$K</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>15</integer>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PL
launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true
launchctl bootstrap gui/\$(id -u) "\$P"
sleep 6
echo "설치했습니다. 방식: \$(cat \$HOME/.jarvis-mirror/mode 2>/dev/null || echo '기록 없음')"
SH
    ;;
  status)
    remote "cat ~/.jarvis-mirror/mode 2>/dev/null; launchctl print gui/\$(id -u)/$LABEL 2>/dev/null | grep -E 'state|pid' | head -2; tail -3 $LOG 2>/dev/null"
    ;;
  *) sed -n '2,16p' "$0"; exit 1 ;;
esac
