#!/usr/bin/env bash
# 폰 알림 수집기(phonenote-svc/cmd/collector)를 이 맥에 설치하거나 지운다. 아이폰 미러링이
# 켜진 맥이어야 폰 알림이 이 맥의 알림 저장소에 들어온다.
#
#   scripts/phonenote-collector install   빌드 → ~/.local/bin, 수집기 토큰 → ~/.config/jarvis/phonenote-token(0600),
#                                         LaunchAgent com.jarvis.phonenote-collector 로 로그인할 때마다 뜬다
#   scripts/phonenote-collector uninstall 멈추고 지운다(토큰 파일과 읽은 위치도)
#   scripts/phonenote-collector status    돌고 있는지, 마지막 로그
#
# 알림 저장소는 macOS 가 지키는 폴더라, 설치한 뒤 한 번 시스템 설정 → 개인정보 보호 및 보안 →
# 전체 디스크 접근 권한에 ~/.local/bin/jarvis-phonenote-collector 를 더해야 읽는다. 그 전에는
# 상태 탭의 "폰 알림" 줄이 권한이 없다고 말한다.
#
# 보내지 않는 것: 회사 업무 앱(Slack·Jira·Outlook/Teams), 메일, 카카오톡·메시지(따로 읽는다),
# 비밀번호 관리자, macOS 자체 알림(지갑의 Apple Pay 결제는 보낸다), 인증번호의 숫자.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${MINI_HOST:-macmini}"
LABEL=com.jarvis.phonenote-collector
BIN="$HOME/.local/bin/jarvis-phonenote-collector"
TOKEN="$HOME/.config/jarvis/phonenote-token"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
URL="${PHONENOTE_URL:-https://jarvis-be.choigonyok.com/phonenote/notes}"
LOG="$HOME/Library/Logs/jarvis-phonenote-collector.log"

case "${1:-}" in
  install)
    mkdir -p "$(dirname "$BIN")" "$(dirname "$TOKEN")" "$(dirname "$PLIST")" "$(dirname "$LOG")"
    (cd "$ROOT/phonenote-svc" && go build -trimpath -o "$BIN" ./cmd/collector)
    if [[ ! -s "$TOKEN" ]]; then
      umask 077
      # 맥미니 .env 에 없으면 만들어 둔다(화면에 찍지 않는다). phonenote 컨테이너가 같은 값을 쓴다.
      ssh -o LogLevel=ERROR "$HOST" 'cd ~/jarvis && { grep -q "^JARVIS_PHONENOTE_TOKEN=" .env || printf "JARVIS_PHONENOTE_TOKEN=%s\n" "$(openssl rand -hex 24)" >> .env; } && grep -E "^JARVIS_PHONENOTE_TOKEN=" .env | cut -d= -f2-' > "$TOKEN"
      [[ -s "$TOKEN" ]] || { echo "맥미니 .env 에서 JARVIS_PHONENOTE_TOKEN 을 읽지 못했습니다" >&2; rm -f "$TOKEN"; exit 1; }
    fi
    chmod 600 "$TOKEN"
    cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$BIN</string><string>-url</string><string>$URL</string><string>-token-file</string><string>$TOKEN</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
PL
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    echo "설치했습니다: $LABEL → $URL"
    echo "남은 한 가지: 시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근 권한에 $BIN 을 더하세요."
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    rm -f "$PLIST" "$BIN" "$TOKEN" "$HOME/.config/jarvis/phonenote-collector.last"
    echo "지웠습니다"
    ;;
  status)
    launchctl print "gui/$(id -u)/$LABEL" 2>/dev/null | grep -E "state|pid" | head -3 || echo "돌고 있지 않습니다"
    tail -5 "$LOG" 2>/dev/null || true
    ;;
  *) sed -n '2,16p' "$0"; exit 1 ;;
esac
