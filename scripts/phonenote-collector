#!/usr/bin/env bash
# 폰 알림 수집기(phonenote-svc/cmd/collector)를 맥미니에 설치하거나 지운다. 맥북에서 실행한다.
# 수집기는 서버 일이라 늘 켜져 있는 맥미니에서 돈다: 맥미니의 알림 저장소를 읽어 같은 맥미니의
# phonenote(127.0.0.1:8104)로 바로 보낸다 - 게이트웨이를 거치지 않는다.
#
#   scripts/phonenote-collector install   빌드해 맥미니 ~/.local/bin/jarvis-phonenote-collector 로 보내고,
#                                         수집기 토큰(맥미니 .env 의 JARVIS_PHONENOTE_TOKEN)을
#                                         ~/.config/jarvis/phonenote-token(0600)에 두고,
#                                         LaunchAgent com.jarvis.phonenote-collector 로 띄운다
#   scripts/phonenote-collector uninstall 맥미니에서 멈추고 지운다(토큰 파일과 읽은 위치도)
#   scripts/phonenote-collector status    맥미니에서 돌고 있는지, 마지막 로그
#
# 사람이 할 일(맥미니 앞에서, 한 번):
# - 폰 알림이 맥미니의 알림 저장소에 들어오려면 맥미니에 아이폰 미러링이 켜져 있어야 한다(iPhone
#   미러링 앱을 한 번 열어 아이폰으로 승인). 알림은 폰이 맥미니 가까이 있을 때 들어온다.
# - 알림 저장소는 macOS 가 지키는 폴더라, 시스템 설정 → 개인정보 보호 및 보안 → 전체 디스크 접근
#   권한 → + → ~/.local/bin/jarvis-phonenote-collector (Cmd+Shift+. 로 숨은 폴더를 보인다).
#   그 전에는 상태 탭의 "폰 알림" 줄이 권한이 없다고 말한다. 다시 설치해 바이너리가 바뀌면 권한을
#   다시 줘야 할 수 있다.
#
# 보내지 않는 것: 회사 업무 앱(Slack·Jira·Outlook/Teams), 메일, 카카오톡·메시지(따로 읽는다),
# 비밀번호 관리자, macOS 자체 알림(지갑의 Apple Pay 결제는 보낸다), 인증번호의 숫자.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
HOST="${MINI_HOST:-macmini}"
LABEL=com.jarvis.phonenote-collector
URL="${PHONENOTE_URL:-http://127.0.0.1:8104/notes}"

remote() { ssh -o LogLevel=ERROR "$HOST" "$@"; }

case "${1:-}" in
  install)
    tmp=$(mktemp -d)
    (cd "$ROOT/phonenote-svc" && GOOS=darwin GOARCH=arm64 go build -trimpath -o "$tmp/jarvis-phonenote-collector" ./cmd/collector)
    remote 'mkdir -p ~/.local/bin'
    scp -q "$tmp/jarvis-phonenote-collector" "$HOST:.local/bin/jarvis-phonenote-collector"
    rm -rf "$tmp"
    remote "bash -s" <<SH
set -e
P=\$HOME/Library/LaunchAgents/$LABEL.plist
B=\$HOME/.local/bin/jarvis-phonenote-collector
T=\$HOME/.config/jarvis/phonenote-token
L=\$HOME/Library/Logs/jarvis-phonenote-collector.log
mkdir -p "\$(dirname "\$T")" "\$(dirname "\$P")" "\$(dirname "\$L")"
cd ~/jarvis
# 토큰은 phonenote 컨테이너의 COLLECTOR_TOKEN 과 같은 값이다. 없으면 만들고 phonenote 를 다시 띄워
# 새 값을 읽게 한다(화면에 찍지 않는다).
if ! grep -q "^JARVIS_PHONENOTE_TOKEN=." .env; then
  printf "JARVIS_PHONENOTE_TOKEN=%s\n" "\$(openssl rand -hex 24)" >> .env
  PATH="/opt/homebrew/bin:/usr/local/bin:/Applications/Docker.app/Contents/Resources/bin:\$PATH" docker compose up -d --no-deps phonenote
fi
(umask 077; grep -E "^JARVIS_PHONENOTE_TOKEN=" .env | cut -d= -f2- > "\$T")
cat > "\$P" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>\$B</string><string>-url</string><string>$URL</string><string>-token-file</string><string>\$T</string><string>-device</string><string>맥미니</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>\$L</string>
  <key>StandardErrorPath</key><string>\$L</string>
</dict></plist>
PL
launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true
launchctl bootstrap gui/\$(id -u) "\$P"
echo "설치했습니다: 맥미니 $LABEL → $URL"
echo "남은 일(맥미니 앞에서): 아이폰 미러링 켜기, 전체 디스크 접근 권한에 \$B 더하기."
SH
    ;;
  uninstall)
    remote "launchctl bootout gui/\$(id -u)/$LABEL 2>/dev/null || true; rm -f ~/Library/LaunchAgents/$LABEL.plist ~/.local/bin/jarvis-phonenote-collector ~/.config/jarvis/phonenote-token ~/.config/jarvis/phonenote-collector.last; echo 지웠습니다"
    ;;
  status)
    remote "if launchctl print gui/\$(id -u)/$LABEL >/dev/null 2>&1; then launchctl print gui/\$(id -u)/$LABEL | grep -E 'state|pid' | head -3; else echo '돌고 있지 않습니다'; fi; tail -5 ~/Library/Logs/jarvis-phonenote-collector.log 2>/dev/null || true"
    ;;
  *) sed -n '2,22p' "$0"; exit 1 ;;
esac
