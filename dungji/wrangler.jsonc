{
  // 둥지: 화면(dist)과 /api 를 한 Worker 가 낸다. 다른 커플도 가입하는 서비스라 Access 뒤에 두지 않는다.
  // 콘솔(jarvis.choigonyok.com)의 일정 칸이 이 주소를 프레임으로 띄운다 - 같은 choigonyok.com 아래라
  // 프레임 안의 로그인 쿠키가 남는다(public/_headers 의 frame-ancestors 가 콘솔만 허락한다).
  "name": "dungji",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "account_id": "bcc3c444a19c4b54e7bb86ccdaf09d1d",
  "routes": [{ "pattern": "dungji.choigonyok.com", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dungji",
      // 배포 전에 `wrangler d1 create dungji` 로 받은 id 로 바꾼다(DEPLOY.md '둥지').
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "HomeLive" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HomeLive"] }],
  "observability": { "enabled": true }

  // 비밀(wrangler secret put): JARVIS_SSO_SECRET(콘솔의 DUNGJI_SSO_SECRET 과 같은 값),
  // 통화용 TURN 은 고를 때만 - CF_TURN_KEY_ID·CF_TURN_KEY_TOKEN 또는 TURN_URLS·TURN_USERNAME·TURN_CREDENTIAL.
}
