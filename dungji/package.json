{
  "name": "dungji",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "worker": "wrangler dev --port 8788",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "check": "wrangler types worker/worker-configuration.d.ts > /dev/null && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply dungji --local",
    "db:remote": "wrangler d1 migrations apply dungji --remote",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.7.10",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.7",
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.4.1",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.1.7",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vitest": "3.1.4",
    "wrangler": "4.153.0"
  }
}
